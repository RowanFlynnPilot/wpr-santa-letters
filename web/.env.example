# Copy to web/.env.local for `npm run dev`. In GitHub, set these as repository variables.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# The WordPress Letters to Santa page (one frame: the mailbag, and the form at #write; README "WordPress embed").
VITE_MAILBAG_PAGE_URL=https://wausaupilotandreview.com/letters-to-santa/
VITE_WRITE_PAGE_URL=https://wausaupilotandreview.com/letters-to-santa/#write
VITE_RULES_URL=https://wausaupilotandreview.com/letters-to-santa-rules/
# Cloudflare's test site key (always passes). Production: the Turnstile widget's site key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
